flowchart LR
    %% Kilde: søknaden-vår.json, revisjon 74.
    %% Alle spørsmål og felt frem til og med erklæringen. Vedleggssiden er utelatt.
    %% Beslektede felt er samlet. Informasjonstekster og validering er ikke vist.
    %% Interne felt i identity og navAddress er ikke definert i JSON-filen.
    %% Gjentakelse av datagrid-rader er beskrevet i feltnodene, ikke som egne spørsmål.

    Start(["Søknad om uføretrygd"])
    Start --> Jobbe
    subgraph Situasjon["1. Din situasjon"]
        Jobbe{"Skal du jobbe ved siden av uføretrygden?"}
        Jobbe -->|Ja| Maaned["Forventet månedsinntekt før skatt som arbeidstaker"]
        Jobbe -->|Nei| Firma
        Maaned --> Firma{"Har du eget firma?"}
        Firma -->|Ja| EgetVedlegg{"Jeg ønsker å legge ved opplysninger<br/>om arbeidsforhold som eget vedlegg"}
        EgetVedlegg -->|Ikke valgt| Firmatekst["Informasjon om firma"]
        Firmatekst --> Firmadata
        EgetVedlegg -->|Valgt| Firmadata["Firmaets organisasjonsnummer og navn"]
        Firmadata --> Gaard
        Firma -->|Nei| Gaard["Driver du gårdsbruk?<br/>Ja/nei"]
    end

    Gaard --> Person
    subgraph Personopplysninger["2. Dine opplysninger"]
        Person["Fornavn, etternavn og identitet"]
        Person --> AdresseVilk["Adresse vises når identitet.harDuFodselsnummer er nei,<br/>eller når identitetsnummer finnes uten ja/nei-svar"]
        AdresseVilk --> Adresse["Adresse, hvis vilkåret er oppfylt"]
        Adresse --> Varighet["Adressevarighet vises ved adresse utenfor Norge,<br/>eller ved norsk adresse med vegadresse/postboksadresse"]
    end

    Varighet --> Status
    subgraph Sivilstatus["3–5. Sivilstatus og ektefelle/partner eller samboer"]
        Status{"Hva er din sivilstatus?"}
        Status -->|Gift eller partner| EktefelleNavn["Ektefelles/partners fornavn og etternavn"]
        EktefelleNavn --> EktefelleId{"Har din ektefelle eller partner<br/>norsk fødselsnummer eller d-nummer?"}
        EktefelleId -->|Ja| EktefelleNummer["Ektefelles/partners fødselsnummer eller d-nummer"]
        EktefelleId -->|Nei| EktefelleDato["Ektefelles/partners fødselsdato"]
        EktefelleNummer --> EktefelleUtland
        EktefelleDato --> EktefelleUtland{"Er din ektefelle eller partner utenlandsk statsborger?"}
        EktefelleUtland -->|Ja| EktefelleStatsborgerskap["Ektefelles/partners statsborgerskap"]
        EktefelleStatsborgerskap --> TidligereNavn{"Hadde din ektefelle eller partner<br/>et annet navn før dere giftet dere?"}
        TidligereNavn -->|Ja| NavnFoer["Ektefelles/partners tidligere navn"]
        NavnFoer --> EktefelleAdresse
        TidligereNavn -->|Nei| EktefelleAdresse
        EktefelleUtland -->|Nei| EktefelleAdresse["Er dere bosatt på samme adresse?<br/>Ja/nei"]

        Status -->|Samboer| SamboerNavn["Samboers fornavn og etternavn"]
        SamboerNavn --> SamboerId{"Har din samboer norsk fødselsnummer eller d-nummer?"}
        SamboerId -->|Ja| SamboerNummer["Samboers fødselsnummer eller d-nummer"]
        SamboerId -->|Nei| SamboerDato["Samboers fødselsdato"]
        SamboerNummer --> SamboerUtland
        SamboerDato --> SamboerUtland{"Er din samboer utenlandsk statsborger?"}
        SamboerUtland -->|Ja| SamboerStatsborgerskap["Samboers statsborgerskap"]
        SamboerUtland -->|Nei| SamboerAdresse
        SamboerStatsborgerskap --> SamboerAdresse["Er du og din samboer bosatt på samme adresse?<br/>Ja/nei<br/>Når ble dere samboere? Måned og år<br/>Har du og din samboer felles barn? Ja/nei"]
    end
    Status -->|Enslig, skilt, separert eller enke/enkemann| ArbeidNaa
    EktefelleAdresse --> ArbeidNaa
    SamboerAdresse --> ArbeidNaa

    subgraph Arbeid["6. Arbeid"]
        ArbeidNaa{"Ja til å jobbe ved siden av uføretrygden?"}
        ArbeidNaa -->|Ja| ArbeidYtelser["Mottar du fostergodtgjørelse eller omsorgslønn? Ja/nei<br/>Mottar du eller vil du få etterlønn eller annet sluttoppgjør fra arbeidsgiver? Ja/nei"]
        ArbeidNaa -->|Nei| FirmaNaa
        ArbeidYtelser --> FirmaNaa{"Ja til eget firma?"}
        FirmaNaa -->|Ja| FirmaArbeid["Er du ansatt i egen bedrift/aksjeselskap? Ja/nei<br/>Mottar du styrehonorar og/eller godtgjørelser i forbindelse med verv? Ja/nei"]
        FirmaNaa -->|Nei| ArbeidSyk
        FirmaArbeid --> ArbeidSyk{"Var du arbeidstaker da du ble syk?"}
        ArbeidSyk -->|Ja| Arbeidsgivere["Arbeidsgivers navn og stillingsprosent<br/>Kan registrere flere arbeidsgivere"]
        ArbeidSyk -->|Nei| NaeringSyk
        Arbeidsgivere --> NaeringSyk{"Var du næringsdrivende eller gårdbruker da du ble syk?"}
        NaeringSyk -->|Ja| Avsluttet["Har du avsluttet næringsvirksomheten?<br/>Ja/nei"]
        NaeringSyk -->|Nei| Tjeneste
        Avsluttet --> Tjeneste{"Har du avtjent militær eller sivil førstegangstjeneste?"}
        Tjeneste -->|Ja| TjenesteAar["Hvilket år avtjente du førstegangstjenesten?"]
    end
    Tjeneste -->|Nei| Opphold
    TjenesteAar --> Opphold

    subgraph Utland["7. Utenlandsopphold"]
        Opphold{"Har du bodd og/eller arbeidet utenfor Norge etter fylte 16 år?"}
        Opphold -->|Ja| Oppholdsdata["Oppholdsland<br/>Opphold fra og til, måned og år<br/>Har du bodd eller arbeidet i oppholdslandet?<br/>Velg bodd og/eller arbeidet<br/>Kan registrere flere opphold"]
        Opphold -->|Nei| Norsk
        Oppholdsdata --> Norsk{"Er du norsk statsborger?"}
        Norsk -->|Nei| Statsborgerskap["Statsborgerskap"]
        Norsk -->|Ja| UtlandPensjon
        Statsborgerskap --> UtlandPensjon{"Mottar du pensjon fra utlandet?"}
        UtlandPensjon -->|Ja| Pensjonsdata["Land du mottar pensjon fra<br/>Type pensjon og beløp per år før skatt<br/>Kan registrere flere pensjoner"]
    end
    UtlandPensjon -->|Nei| Skade
    Pensjonsdata --> Skade["8. Yrkesskade og yrkessykdom<br/>Har du en godkjent yrkesskade eller yrkessykdom<br/>som er årsak til at du søker om uføretrygd? Ja/nei"]
    Skade --> HarBarn

    subgraph Barn["9. Barn under 18 år"]
        HarBarn{"Har du barn under 18 år?"}
        HarBarn -->|Ja| ForelderStatus{"Sivilstatus?"}
        ForelderStatus -->|Gift eller partner| EktefelleForelder["Er din ektefelle eller partner forelder til barnet<br/>du søker barnetillegg for? Ja/nei"]
        ForelderStatus -->|Samboer| SamboerForelder["Er din samboer forelder til barnet<br/>du søker barnetillegg for? Ja/nei"]
        ForelderStatus -->|Andre svar| BarnNavn
        EktefelleForelder --> BarnNavn["Barnets fornavn og etternavn"]
        SamboerForelder --> BarnNavn
        BarnNavn --> BarnId{"Har dette barnet norsk fødselsnummer eller d-nummer?"}
        BarnId -->|Ja| BarnNummer["Barnets fødselsnummer/d-nummer"]
        BarnId -->|Nei| BarnDato["Barnets fødselsdato"]
        BarnDato --> BarnBilde["Har barnet eller barna legitimasjon med bilde?<br/>Ja/nei"]
        BarnNummer --> BarnAdresse
        BarnBilde --> BarnAdresse{"Bor barnet og begge foreldrene på samme adresse?"}
        BarnAdresse -->|Ja| Foster
        BarnAdresse -->|Nei| Delt{"Har dere avtale om delt bosted etter barneloven § 36?"}
        Delt -->|Ja| Foster
        Delt -->|Nei| BorMedDeg{"Bor barnet med deg?"}
        BorMedDeg -->|Ja| Foster
        BorMedDeg -->|Nei| Forsoerger{"Forsørger du barnet?"}
        Forsoerger -->|Nei| Foster
        Forsoerger -->|Ja| Bidrag["Betales det bidrag for barnet via Nav?<br/>Ja/nei"]
        Bidrag --> Foster["Er barnet ditt fosterbarn? Ja/nei<br/>Gjenta barneopplysningene for hvert barn"]
    end
    Foster --> Inntektsaar

    subgraph EgenInntekt["10. Egen inntekt: vises ved barn under 18 år"]
        Inntektsaar["Året inntektsopplysningene gjelder for"]
        Inntektsaar --> EgenArbeid{"Har du eller forventer du å få arbeidsinntekt?"}
        EgenArbeid -->|Ja| EgenArbeidBeloep["Årlig brutto arbeidsinntekt"]
        EgenArbeid -->|Nei| EgenNav
        EgenArbeidBeloep --> EgenNav{"Mottar du en eller flere pensjonsgivende ytelser fra Nav?"}
        EgenNav -->|Ja| EgenNavBeloep["Forventet brutto årlig pensjonsgivende ytelser"]
        EgenNav -->|Nei| EgenNaering
        EgenNavBeloep --> EgenNaering{"Har du eller forventer du å få næringsinntekt?"}
        EgenNaering -->|Ja| EgenNaeringBeloep["Brutto årlig næringsinntekt"]
        EgenNaering -->|Nei| EgenUtland
        EgenNaeringBeloep --> EgenUtland{"Har du eller forventer du å få inntekt fra utlandet?"}
        EgenUtland -->|Ja| EgenUtlandBeloep["Brutto årsinntekt fra utlandet"]
        EgenUtland -->|Nei| EgenAndre
        EgenUtlandBeloep --> EgenAndre{"Mottar du pensjon fra andre enn Nav, offentlig eller privat?"}
        EgenAndre -->|Ja| EgenAndreBeloep["Brutto årlig pensjon fra andre enn Nav"]
        EgenAndre -->|Nei| EgenFamilie
        EgenAndreBeloep --> EgenFamilie{"Mottar du familiepleieytelse og/eller krigspensjon fra Nav?"}
        EgenFamilie -->|Ja| EgenFamilieBeloep["Brutto årlig familiepleieytelse og krigspensjon fra Nav"]
        EgenFamilie -->|Nei| PensjonVilk
        EgenFamilieBeloep --> PensjonVilk{"Ja til pensjon fra utlandet på side 7?"}
        PensjonVilk -->|Ja| EgenPensjon{"Mottar du pensjon fra utlandet?"}
        EgenPensjon -->|Ja| EgenPensjonBeloep["Brutto årlig pensjon fra utlandet"]
    end
    PensjonVilk -->|Nei| EktefelleInntektVilk
    EgenPensjon -->|Nei| EktefelleInntektVilk
    EgenPensjonBeloep --> EktefelleInntektVilk

    EktefelleInntektVilk{"Ja til at ektefelle/partner er forelder<br/>til barnet det søkes barnetillegg for?"}
    EktefelleInntektVilk -->|Ja| EPArbeid
    EktefelleInntektVilk -->|Nei eller ikke aktuelt| SamboerInntektVilk
    subgraph EktefelleInntekt["11. Ektefelles eller partners inntekt"]
        EPArbeid{"Har din ektefelle eller partner arbeidsinntekt?"}
        EPArbeid -->|Ja| EPArbeidBeloep["Beløp årlig brutto arbeidsinntekt"]
        EPArbeid -->|Nei| EPNav
        EPArbeidBeloep --> EPNav{"Mottar din ektefelle eller partner<br/>en eller flere pensjonsgivende ytelser fra Nav?"}
        EPNav -->|Ja| EPNavBeloep["Forventet brutto årlig pensjonsgivende ytelser"]
        EPNav -->|Nei| EPNaering
        EPNavBeloep --> EPNaering{"Har din ektefelle eller partner næringsinntekt?"}
        EPNaering -->|Ja| EPNaeringBeloep["Brutto årlig næringsinntekt"]
        EPNaering -->|Nei| EPUtland
        EPNaeringBeloep --> EPUtland{"Har din ektefelle eller partner inntekt fra utlandet?"}
        EPUtland -->|Ja| EPUtlandBeloep["Brutto årsinntekt fra utlandet"]
        EPUtland -->|Nei| EPAndre
        EPUtlandBeloep --> EPAndre{"Mottar din ektefelle eller partner<br/>pensjon fra andre enn Nav, offentlig eller privat?"}
        EPAndre -->|Ja| EPAndreBeloep["Brutto årlig pensjon fra andre enn Nav"]
        EPAndre -->|Nei| EPStoenad
        EPAndreBeloep --> EPStoenad{"Mottar din ektefelle eller partner introduksjonsstønad,<br/>supplerende stønad eller krigspensjon fra Nav?"}
        EPStoenad -->|Ja| EPStoenadBeloep["Brutto årlig introduksjonsstønad,<br/>supplerende stønad og krigspensjon fra Nav"]
        EPStoenad -->|Nei| EPPensjon
        EPStoenadBeloep --> EPPensjon{"Mottar ektefelle eller partner pensjon fra utlandet?"}
        EPPensjon -->|Ja| EPPensjonBeloep["Brutto årlig pensjon fra utlandet"]
    end
    EPPensjon -->|Nei| SamboerInntektVilk
    EPPensjonBeloep --> SamboerInntektVilk

    SamboerInntektVilk{"Ja til at samboer er forelder<br/>til barnet det søkes barnetillegg for?"}
    SamboerInntektVilk -->|Ja| SArbeid
    SamboerInntektVilk -->|Nei eller ikke aktuelt| Utenfor
    subgraph SamboerInntekt["12. Samboers inntekt"]
        SArbeid{"Har din samboer arbeidsinntekt?"}
        SArbeid -->|Ja| SArbeidBeloep["Beløp årlig brutto arbeidsinntekt"]
        SArbeid -->|Nei| SNav
        SArbeidBeloep --> SNav{"Mottar din samboer én eller flere pensjonsgivende ytelser fra Nav?"}
        SNav -->|Ja| SNavBeloep["Forventet brutto årlig pensjonsgivende ytelser"]
        SNav -->|Nei| SNaering
        SNavBeloep --> SNaering{"Har din samboer næringsinntekt?"}
        SNaering -->|Ja| SNaeringBeloep["Brutto årlig næringsinntekt"]
        SNaering -->|Nei| SUtland
        SNaeringBeloep --> SUtland{"Har din samboer inntekt fra utlandet?"}
        SUtland -->|Ja| SUtlandBeloep["Brutto årsinntekt fra utlandet"]
        SUtland -->|Nei| SAndre
        SUtlandBeloep --> SAndre{"Mottar din samboer pensjon fra andre enn Nav, offentlig eller privat?"}
        SAndre -->|Ja| SAndreBeloep["Brutto årlig pensjon fra andre enn Nav"]
        SAndre -->|Nei| SStoenad
        SAndreBeloep --> SStoenad{"Mottar samboeren din introduksjonsstønad,<br/>supplerende stønad eller krigspensjon fra Nav?"}
        SStoenad -->|Ja| SStoenadBeloep["Brutto årlig introduksjonsstønad,<br/>supplerende stønad og krigspensjon fra Nav"]
        SStoenad -->|Nei| SPensjon
        SStoenadBeloep --> SPensjon{"Mottar samboeren din pensjon fra utlandet?"}
        SPensjon -->|Ja| SPensjonBeloep["Brutto årlig pensjon fra utlandet"]
    end
    SPensjon -->|Nei| Utenfor
    SPensjonBeloep --> Utenfor
    HarBarn -->|Nei| Utenfor

    subgraph Bosted["13. Bor utenfor Norge og EØS"]
        Utenfor{"Bor du utenfor Norge eller EØS?"}
        Utenfor -->|Ja| NorgeOpphold{"Har du hatt opphold i Norge?"}
        NorgeOpphold -->|Ja| NorgePerioder["Periodene du har bodd i Norge<br/>Opphold fra og til, måned og år<br/>Kan registrere flere perioder"]
        NorgeOpphold -->|Nei| IArbeid
        NorgePerioder --> IArbeid{"Er du i arbeid nå?"}
        IArbeid -->|Nei| Sluttet["Når sluttet du å arbeide? Måned og år"]
        IArbeid -->|Ja| Utdanning
        Sluttet --> Utdanning{"Har du utdanning?"}
        Utdanning -->|Ja| Utdanningsdata["Skole/kurs<br/>Utdanning fra og til, måned og år<br/>Grad/tittel<br/>Kan registrere flere utdanninger"]
        Utdanning -->|Nei| Arbeidsforhold
        Utdanningsdata --> Arbeidsforhold{"Har du arbeidsforhold?"}
        Arbeidsforhold -->|Ja| Arbeidsdata["Arbeidsgiver, stilling og stillingsprosent<br/>Ansatt fra og til, måned og år<br/>Kan registrere flere arbeidsforhold"]
    end
    Utenfor -->|Nei| Ekstra
    Arbeidsforhold -->|Nei| Ekstra
    Arbeidsdata --> Ekstra

    subgraph Dokumentasjon["14. Ekstra dokumentasjon til Nav"]
        Ekstra{"Har du avtalt med Nav at du skal sende mer dokumentasjon?"}
        Ekstra -->|Ja| Beskrivelse["Hvilken dokumentasjon har du avtalt med Nav du skal sende?"]
    end
    Ekstra -->|Nei| Erklaering
    Beskrivelse --> Erklaering["15. Erklæring<br/>Obligatorisk bekreftelse:<br/>Nav kan innhente nødvendige opplysninger.<br/>Opplysningene er gitt etter beste skjønn og overbevisning<br/>og er så fullstendige som mulig.<br/>Erklæringen og underskriften gjelder hele søknaden."]
    Erklaering --> Slutt(["Slutt på flyten uten vedleggssiden"])
